{
  "version": 1,
  "description": "Selective context loading map. Only instruction files matching the edited file's globs are loaded alongside AGENTS.md.",
  "defaultInstructions": [
    ".kilo/instructions/typescript-rules.md"
  ],
  "mappings": [
    {
      "glob": "src/hooks/useStorage.tsx",
      "instructions": [".kilo/instructions/state-management.md"]
    },
    {
      "glob": "src/lib/storage.ts",
      "instructions": [".kilo/instructions/state-management.md"]
    },
    {
      "glob": "src/lib/**/ai*.ts",
      "instructions": [".kilo/instructions/ai-integration.md"]
    },
    {
      "glob": "src/config/ai.ts",
      "instructions": [".kilo/instructions/ai-integration.md"]
    },
    {
      "glob": "src/lib/hooks/useAiQueueProvider.tsx",
      "instructions": [".kilo/instructions/ai-integration.md"]
    },
    {
      "glob": "src/lib/hooks/useSession.ts",
      "instructions": [".kilo/instructions/animations.md"]
    },
    {
      "glob": "src/components/ui/**/*.tsx",
      "instructions": [".kilo/instructions/animations.md", ".kilo/instructions/theme-system.md"]
    },
    {
      "glob": "src/screens/**/*.tsx",
      "instructions": [".kilo/instructions/animations.md", ".kilo/instructions/theme-system.md"]
    },
    {
      "glob": "src/styles/**/*.ts",
      "instructions": [".kilo/instructions/theme-system.md"]
    },
    {
      "glob": "src/lib/hooks/useSecurity.ts",
      "instructions": [".kilo/instructions/security.md"]
    },
    {
      "glob": "src/components/features/*/**/*.tsx",
      "instructions": [".kilo/instructions/animations.md", ".kilo/instructions/theme-system.md"]
    }
  ]
}
